---
import type { Content } from '../i18n/types';
interface Props { content: Content }
const { content } = Astro.props;
---
<section id="services" class="section services-section" aria-labelledby="services-title">
  <div class="container">
    <div class="section-heading services-heading">
      <div><p class="eyebrow"><span class="eyebrow-line"></span>{content.services.eyebrow}</p><h2 id="services-title">{content.services.title}</h2></div>
      <p>{content.services.intro}</p>
    </div>
    <div class="services-grid">
      {content.services.items.map((item, index) => <article class="service-card">
        <div class="service-card-top"><span class="service-number">0{index + 1}</span><span class="service-symbol" aria-hidden="true">
          {index === 0 ? <svg viewBox="0 0 48 48" fill="none"><path d="M10 37 36 11M18 38l21-21M34 9l5 5M8 33l6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="13" cy="35" r="2" fill="currentColor"/></svg> : index === 1 ? <svg viewBox="0 0 48 48" fill="none"><path d="M7 30c6-10 11-12 16-8 4 3 3 8 9 8 3 0 6-2 9-5M7 38c6-10 11-12 16-8 4 3 3 8 9 8 3 0 6-2 9-5M11 16c3-5 7-7 12-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg> : <svg viewBox="0 0 48 48" fill="none"><path d="M12 11h24l-3 23c-.3 2.8-2.7 5-5.5 5h-7c-2.8 0-5.2-2.2-5.5-5l-3-23ZM10 11h28M20 17v12M28 17v12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>}
        </span></div>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
        <a class="text-link" href="#contact">{content.services.consult}<span aria-hidden="true">↗</span></a>
      </article>)}
    </div>
  </div>
</section>
