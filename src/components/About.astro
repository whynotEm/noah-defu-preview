---
import { asset } from '../data/paths';
import { images } from '../data/site';
import type { Content } from '../i18n/types';
interface Props { content: Content }
const { content } = Astro.props;
---
<section id="about" class="section about-section" aria-labelledby="about-title">
  <div class="container split-grid about-grid">
    <figure class="about-visual">
      <img src={asset(images.about)} alt={content.about.imageAlt} width="1536" height="1024" loading="lazy" decoding="async" />
      <figcaption>{content.about.conceptNote}</figcaption>
    </figure>
    <div class="section-copy about-copy">
      <p class="eyebrow"><span class="eyebrow-line"></span>{content.about.eyebrow}</p>
      <h2 id="about-title">{content.about.title}</h2>
      <p>{content.about.p1}</p>
      <p>{content.about.p2}</p>
      <a class="text-link" href="#contact">{content.about.link}<span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
